# ── RedactGate admin console configuration ───────────────────────────────────
# Server-side base URL of the RedactGate FastAPI service (admin endpoints live here).
REDACTGATE_API_BASE=http://localhost:8088

# Admin token gating the /admin/* API (same value as the gateway's ADMIN_TOKEN). Sent as
# X-Admin-Token from the server only; it never reaches the browser bundle.
REDACTGATE_ADMIN_TOKEN=

# Clerk (https://dashboard.clerk.com). Without both keys the console builds but only
# serves /setup. In Clerk: enable Organizations, and add a role with key `compliance`
# (read-only audit). Default roles org:admin / org:member are used as-is.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
