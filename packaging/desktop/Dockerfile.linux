# Linux build (Debian bookworm, glibc 2.36 -> runs on Ubuntu 22.04+/Debian 12+ and newer).
FROM python:3.12-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends file desktop-file-utils && rm -rf /var/lib/apt/lists/*
COPY requirements-desktop.txt /tmp/requirements-desktop.txt
RUN pip install --no-cache-dir -r /tmp/requirements-desktop.txt "pyinstaller==6.22.*"
RUN curl -fsSL -o /usr/local/bin/appimagetool https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage \
 && chmod +x /usr/local/bin/appimagetool
